# Copy to .env (git-ignored). Vite exposes VITE_* vars to the overlay frontend.
# scripts/deploy.sh fills both values in automatically.

# Public HTTPS URL of the relay (Container App). The overlay derives wss:// from it
# and the QR encodes <URL>/r/<ROOM>. Leave empty and the overlay still launches;
# the QR widget shows "no relay configured".
VITE_RELAY_URL=

# Shared secret: must equal the relay's RELAY_DESKTOP_KEY (Container App secret
# "desktop-key"). Only sockets presenting it may act as the presenter's overlay.
VITE_RELAY_KEY=

# The ending (Ctrl+Shift+E) shows a full-screen QR of this URL: the Mystica game the students
# join after the webinar. Leave empty and the ending shows a greyed QR with "not set".
VITE_MYSTICA_URL=

# Optional: a free Freesound API key (https://freesound.org/apiv2/apply/) lets tools/sounds/harvest.mjs
# search its CC0 recordings too; without it the harvest uses Kenney and OpenGameArt only.
FREESOUND_KEY=
